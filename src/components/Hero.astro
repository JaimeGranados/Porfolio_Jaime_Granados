---
const personalImageAlt = "Jaime Granados"
import Badge from "@/components/Badge.astro"
import GitHubIcon from "@/components/icons/GitHub.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"
import SparklesIcon from "@/components/icons/Sparkles.astro"
import SocialPill from "@/components/SocialPill.astro"
---

<div class="max-w-xl">
  <div class="anim-fade-in flex gap-4 mb-6 items-center">
    <!-- Avatar with ambient glow -->
    <div class="relative flex-shrink-0">
      <div
        class="absolute inset-0 rounded-full bg-yellow-400/30 dark:bg-yellow-400/20 blur-xl scale-125"
        aria-hidden="true"
      >
      </div>
      <img
        class="relative rounded-full shadow-2xl size-20 ring-2 ring-blue-400/60 ring-offset-2 ring-offset-gray-50 dark:ring-offset-gray-950"
        src="/me.jpg"
        alt={personalImageAlt}
      />
    </div>
    <a
      href="https://www.linkedin.com/in/jaime-granados-903734397"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge><SparklesIcon class="size-3" /> <span data-es="Disponible para trabajar" data-en="Available for work">Disponible para trabajar</span></Badge>
    </a>
  </div>

  <h1
    class="anim-fade-in anim-delay-1 text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
    <span data-es="Hola, soy" data-en="Hi, I'm">Hola, soy</span> <span class="gradient-name">Jaime Grandos</span> 
  </h1>

  <p
    class="anim-fade-in anim-delay-2 mt-6 text-xl text-gray-800 dark:[&>strong]:text-yellow-200 [&>strong]:text-yellow-500 [&>strong]:font-semibold dark:text-gray-300"
  >
   <span
      data-es="Estudiante de Ingeniería de Sistemas con experiencia real en datos. Analista de Datos con dominio de SQL avanzado, Power BI, PostgreSQL, Python, pandas y NumPy, con base en Valledupar, Colombia. Transformo datos complejos en decisiones claras y seguras."
      data-en="Systems Engineering student with real hands-on data experience. Data Analyst skilled in advanced SQL, Power BI, PostgreSQL, Python, pandas and NumPy, based in Valledupar, Colombia. I turn complex data into clear, reliable decisions."
  >
  </p>
  <nav
    class="anim-fade-in anim-delay-3 flex flex-wrap gap-4 mt-8"
    aria-label="Redes sociales y contacto"
  >
    <SocialPill href="https://mail.google.com/mail/?view=cm&fs=1&to=jaimealfonsogranados3@gmail.com" target="_blank">
      <MailIcon class="size-4" />
      Contáctame
    </SocialPill>
    <SocialPill href="https://www.linkedin.com/in/jaime-granados-903734397">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
    <SocialPill href="https://github.com/JaimeGranados">
      <GitHubIcon class="size-4" />
      GitHub
    </SocialPill>
  </nav>
</div>
