---
import "@fontsource-variable/onest";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ViewTransitions } from "astro:transitions";

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
}

const {
  description,
  title,
  image = "/porfolio.webp",
  canonical = Astro.url.href,
} = Astro.props;

const siteUrl = "https://porfolio.dev";
const ogImage = new URL(image, siteUrl).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Jaime Granados",
  url: siteUrl,
  sameAs: [
    "https://www.linkedin.com/in/jaimegranados",
    "https://github.com/JaimeGranados",
  ],
  jobTitle: "Ingeniero en Sistemas y Analista de Datos",
  worksFor: {
    "@type": "Organization",
    name: "Freelance",
  },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Jaime Granados" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Jaime Granados · Porfolio" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@jaimegranados" />
    <meta name="twitter:creator" content="@jaimegranados" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD structured data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="darkreader-lock" />
    <ViewTransitions />
  </head>

  <body class="relative text-black dark:text-white">
   <div class="fixed inset-0 z-[-2] bg-gray-50 dark:bg-[#020408] gradient-waves">
    </div>
    <!-- Grain texture overlay for tactile depth -->
    <div
      class="pointer-events-none fixed inset-0 z-[-1] opacity-[0.035] dark:opacity-[0.05]"
      style="background-image: url('/noise.svg'); background-size: 200px 200px;"
      aria-hidden="true"
    >
    </div>
    <Header />
    <slot />
    <Footer />
    <style is:global>
      :root {
        color-scheme: light dark;
      }

     .gradient-waves {
        background-image:
          radial-gradient(ellipse 70% 60% at 20% 20%, rgba(99,102,241,0.18), transparent 65%),
          radial-gradient(ellipse 65% 55% at 80% 25%, rgba(30,58,138,0.22), transparent 65%),
          radial-gradient(ellipse 60% 50% at 50% 85%, rgba(220,38,38,0.10), transparent 65%),
          radial-gradient(ellipse 55% 50% at 90% 90%, rgba(99,102,241,0.12), transparent 65%);
        background-size: 220% 220%;
        animation: wave-shift 20s linear infinite;
      }

     .dark .gradient-waves {
        background-image:
          radial-gradient(ellipse 70% 60% at 20% 20%, rgba(99,102,241,0.16), transparent 65%),
          radial-gradient(ellipse 65% 55% at 80% 25%, rgba(30,58,138,0.20), transparent 65%),
          radial-gradient(ellipse 60% 50% at 50% 85%, rgba(220,38,38,0.08), transparent 65%),
          radial-gradient(ellipse 55% 50% at 90% 90%, rgba(99,102,241,0.10), transparent 65%);
      }

      @keyframes wave-shift {
        0% {
          background-position: 0% 0%, 100% 0%, 50% 100%, 100% 100%;
        }
        25% {
          background-position: 25% 15%, 75% 20%, 60% 85%, 85% 90%;
        }
        50% {
          background-position: 50% 25%, 50% 35%, 65% 65%, 65% 75%;
        }
        75% {
          background-position: 25% 15%, 75% 20%, 60% 85%, 85% 90%;
        }
        100% {
          background-position: 0% 0%, 100% 0%, 50% 100%, 100% 100%;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .gradient-waves {
          animation: none;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .gradient-waves {
          transition: none;
        }
      }

      html {
        font-family: "Onest Variable", system-ui, sans-serif;
        scroll-behavior: smooth;
      }

      body {
        color: rgba(17, 17, 17, 0.9);
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overscroll-behavior: none;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }

      @media (prefers-color-scheme: dark) {
        body {
          color: rgba(255, 255, 255, 0.9);
        }
      }

      @keyframes blur {
        to {
          backdrop-filter: blur(20px);
          border-width: 1px;
          border-color: rgba(0, 0, 0);
          padding: 0.25rem 0.75rem;
          display: flex;
          flex-direction: row;
          align-items: center;
          background-color: rgb(229, 229, 229);
          border-radius: 9999px;
        }
      }

      @media (prefers-color-scheme: dark) {
        @keyframes blur {
          from {
            border: 0px;
          }
          to {
            box-shadow:
              0px 5px 50px -5px rgba(0, 0, 0, 0.1),
              0px 0px 0 1px rgba(0, 0, 0, 0.3);
            background: rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(20px);
            border-width: 1px;
            border-color: rgba(0, 0, 0);
            padding-left: 0.75rem;
            padding-right: 0.75rem;
            padding-top: 0.25rem;
            padding-bottom: 0.25rem;
            display: flex;
            flex-direction: row;
            align-items: center;
            background-color: rgba(0, 0, 0, 0.3);
            border-radius: 9999px;
          }
        }
      }

      /* ── Design system: staggered entrance animations ─────────────── */
      @keyframes fade-in-up {
        from {
          opacity: 0;
          translate: 0 20px;
        }
        to {
          opacity: 1;
          translate: 0 0;
        }
      }

      .anim-fade-in {
        animation: fade-in-up 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
      }
      .anim-delay-1 { animation-delay: 120ms; }
      .anim-delay-2 { animation-delay: 260ms; }
      .anim-delay-3 { animation-delay: 400ms; }
      .anim-delay-4 { animation-delay: 540ms; }

      /* Gradient text utility for the hero name */
      .gradient-name {
        background: linear-gradient(135deg, #4d176d 10%, #5b0ee9 80%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        color: transparent;
      }

      /* Scroll-triggered reveal for named sections (below the fold) */
      @supports (animation-timeline: view()) {
        [data-section] {
          animation: fade-in-up 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
          animation-timeline: view();
          animation-range: entry 0% entry 18%;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .anim-fade-in,
        [data-section] {
          animation: none !important;
          opacity: 1 !important;
          translate: none !important;
        }
      }
    </style>
  </body>
</html>
